{
  "pathBase": "spec",
  "docsRoot": "../queryn-docs/docs",
  "archiveRoots": ["../queryn-docs/docs/archive"],
  "commentHygieneConfig": "scripts/comment-hygiene/repos.json",
  "codeArrowRepositories": [
    "queryn-core",
    "queryn-sdk",
    "queryn-runtime",
    "queryn-desktop",
    "queryn-extensions"
  ],
  "projectFormatSchema": "schemas/queryn.schema.json",
  "projectFormatSources": ["../queryn-core/packages/project/src/migration.ts"],
  "hostVersionSources": ["../queryn-runtime/src/extension-manager.ts"],
  "versionSensitivePages": [
    { "path": "../queryn-docs/docs/architecture/versioning-and-migrations.md", "requiredVersions": ["0.1", "0.2"] },
    { "path": "../queryn-docs/docs/product/queryn.md", "requiredVersions": ["0.1", "0.2"] },
    { "path": "../queryn-docs/docs/product/roadmap.md", "requiredVersions": ["0.1", "0.2"] },
    { "path": "../queryn-docs/docs/product/jobs-and-non-goals.md", "requiredVersions": ["0.2"] },
    { "path": "../queryn-docs/docs/specification/index.md", "requiredVersions": ["0.1", "0.2"] }
  ],
  "mermaid": {
    "command": "node",
    "args": ["node_modules/@mermaid-js/mermaid-cli/src/cli.js"],
    "timeoutMs": 120000
  },
  "readmes": [
    "../queryn-core/README.md",
    "../queryn-desktop/README.md",
    "../queryn-docs/README.md",
    "../queryn-sdk/README.md",
    "../queryn-extensions/README.md",
    "../queryn-runtime/README.md",
    "README.md"
  ],
  "requiredReadmeSections": [
    "Статус",
    "Stack",
    "Команды",
    "Границы",
    "Связанные репозитории",
    "Лицензия"
  ],
  "docsBuild": {
    "enabled": true,
    "cwd": "../queryn-docs",
    "config": "../queryn-docs/docs/.vitepress/config.ts",
    "command": "pnpm",
    "args": ["build"],
    "timeoutMs": 180000
  },
  "docMap": [
    { "module": "../queryn-core/packages/project/src/migration.ts", "page": "architecture/versioning-and-migrations.md" },
    { "module": "../queryn-runtime/src/agent-kernel.ts", "page": "architecture/ai-runtime.md" },
    { "module": "../queryn-runtime/src/rpc-server.ts", "page": "architecture/runtime-and-security.md" },
    { "module": "../queryn-desktop/src/preload/index.ts", "page": "architecture/desktop.md" },
    { "module": "../queryn-sdk/src/index.ts", "page": "contributing/extensions.md" },
    { "module": "../queryn-spec/schemas/queryn.schema.json", "page": "specification/index.md" }
  ]
}
