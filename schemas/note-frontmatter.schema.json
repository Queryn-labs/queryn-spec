{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.osnova.local/schemas/note-frontmatter.schema.json",
  "title": "Osnova Note Frontmatter Draft",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
