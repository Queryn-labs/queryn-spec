{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.queryn.local/schemas/relation.schema.json",
  "title": "Queryn Relation Draft",
  "type": "object",
  "required": ["id", "from", "to", "type"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "from": { "$ref": "#/$defs/entityRef" },
    "to": { "$ref": "#/$defs/entityRef" },
    "type": {
      "type": "string",
      "enum": ["references", "depends-on", "explains", "contradicts", "related"]
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["note", "asset", "card"] },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
