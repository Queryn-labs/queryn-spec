{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.osnova.local/schemas/osnova.schema.json",
  "title": "Osnova Project Manifest",
  "type": "object",
  "required": ["formatVersion", "id", "name", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "string",
      "enum": ["0.1", "0.2"]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": ["general", "subject", "exam"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "institution": { "type": "string" }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "targetScore": { "type": "number", "minimum": 0 }
      }
    },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/extensionRequirement" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "extensionRequirement": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "version": { "type": "string", "pattern": "^(?:\\*|latest|[~^]?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)$" },
        "enabled": { "type": "boolean", "default": true }
      }
    }
  }
}
