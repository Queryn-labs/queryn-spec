{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.queryn.local/schemas/session.schema.json",
  "title": "Queryn Session",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "status", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string" },
    "status": { "$ref": "#/$defs/sessionStatus" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactId"],
        "additionalProperties": false,
        "properties": { "artifactId": { "type": "string", "minLength": 1 } }
      }
    },
    "memoryMode": { "$ref": "#/$defs/memoryMode" }
  },
  "$defs": {
    "sessionStatus": {
      "title": "SessionStatus",
      "type": "string",
      "enum": ["active", "completed", "archived"]
    },
    "memoryMode": {
      "type": "string",
      "enum": ["full", "off"]
    }
  }
}
