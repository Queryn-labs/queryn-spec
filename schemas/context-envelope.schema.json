{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.osnova.local/schemas/context-envelope.schema.json",
  "title": "Osnova Context Envelope",
  "type": "object",
  "required": ["level", "sources", "sensitivity", "allowedRecipients", "tokenEstimate", "truncated", "providerVersion"],
  "additionalProperties": false,
  "properties": {
    "level": { "enum": ["compact", "expanded"] },
    "text": { "type": "string" },
    "structured": { "type": "object" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "sensitivity": { "enum": ["public", "project", "sensitive"] },
    "allowedRecipients": { "type": "array", "items": { "enum": ["local", "cloud"] }, "uniqueItems": true },
    "tokenEstimate": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" },
    "freshness": { "type": "string", "format": "date-time" },
    "providerVersion": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "source": {
      "type": "object", "required": ["artifactId"], "additionalProperties": false,
      "properties": { "artifactId": { "type": "string", "minLength": 1 }, "payloadPath": { "type": "string" }, "providerId": { "type": "string" } }
    }
  }
}
